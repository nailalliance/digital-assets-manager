{% form_theme form 'tailwind_form_theme.html.twig' %}
{{ form_start(form) }}
    {{ form_row(form.name) }}
    {{ form_row(form.categories) }}
    {{ form_row(form.status) }}

    <section class="mt-8 rounded-md border border-violet-200 bg-violet-50 p-5">
        <h2 class="text-lg font-semibold text-gray-900">Designer-only asset access</h2>
        <p class="mt-1 mb-4 text-sm text-gray-600">Grant selected regular users access without changing their roles.</p>
        {{ include('admin/_designer_access_selector.html.twig', {field: form.designerAccessUsers}) }}
    </section>
<div class="mt-8 pt-5 border-t border-gray-200 flex justify-end space-x-3">
    <a href="{{ path('admin_categories_index') }}"
       class="bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50">
        Back to list
    </a>
    <button
        class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-violet-600 hover:bg-violet-700">
        {{ button_label|default('Save') }}
    </button>
</div>
{{ form_end(form) }}
