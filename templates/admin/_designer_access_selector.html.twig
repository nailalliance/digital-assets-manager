<div data-controller="dual-list-selector">
    {{ form_label(field) }}
    {{ form_errors(field) }}

    <div hidden class="mt-3 grid grid-cols-1 gap-4 md:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] md:items-center"
         data-dual-list-selector-target="interface">
        <div>
            <div class="mb-2 flex items-center justify-between">
                <label for="{{ field.vars.id }}_available" class="text-sm font-semibold text-gray-700">No access</label>
                <span class="rounded-full bg-gray-200 px-2 py-0.5 text-xs font-medium text-gray-700"
                      data-dual-list-selector-target="availableCount">0</span>
            </div>
            <select id="{{ field.vars.id }}_available"
                    multiple
                    size="12"
                    class="block h-72 w-full rounded-md border border-gray-300 bg-white p-2 text-sm shadow-sm focus:border-violet-500 focus:ring-violet-500"
                    aria-label="Users without designer-only asset access"
                    data-dual-list-selector-target="available"
                    data-action="change->dual-list-selector#refresh dblclick->dual-list-selector#grantOnDoubleClick">
            </select>
        </div>

        <div class="flex justify-center gap-2 md:flex-col">
            <button type="button"
                    class="inline-flex min-w-28 items-center justify-center rounded-md bg-violet-600 px-3 py-2 text-sm font-medium text-white shadow-sm hover:bg-violet-700 disabled:cursor-not-allowed disabled:opacity-40 md:min-w-10"
                    title="Grant access to highlighted users"
                    data-dual-list-selector-target="grantButton"
                    data-action="click->dual-list-selector#grant">
                <span class="md:hidden">Grant&nbsp;</span><span aria-hidden="true">→</span>
                <span class="sr-only">Grant access</span>
            </button>
            <button type="button"
                    class="inline-flex min-w-28 items-center justify-center rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-40 md:min-w-10"
                    title="Remove access from highlighted users"
                    data-dual-list-selector-target="revokeButton"
                    data-action="click->dual-list-selector#revoke">
                <span aria-hidden="true">←</span><span class="md:hidden">&nbsp;Remove</span>
                <span class="sr-only">Remove access</span>
            </button>
        </div>

        <div>
            <div class="mb-2 flex items-center justify-between">
                <label for="{{ field.vars.id }}_granted" class="text-sm font-semibold text-gray-700">Has access</label>
                <span class="rounded-full bg-violet-100 px-2 py-0.5 text-xs font-medium text-violet-800"
                      data-dual-list-selector-target="grantedCount">0</span>
            </div>
            <select id="{{ field.vars.id }}_granted"
                    multiple
                    size="12"
                    class="block h-72 w-full rounded-md border border-violet-300 bg-white p-2 text-sm shadow-sm focus:border-violet-500 focus:ring-violet-500"
                    aria-label="Users with designer-only asset access"
                    data-dual-list-selector-target="granted"
                    data-action="change->dual-list-selector#refresh dblclick->dual-list-selector#revokeOnDoubleClick">
            </select>
        </div>
        <p class="text-xs text-gray-600 md:col-span-3">
            Highlight users and use the arrows to move them. Every user listed under <strong>Has access</strong> is granted access, whether highlighted or not.
        </p>
    </div>
    {{ form_help(field) }}

    {{ form_widget(field, {
        attr: {
            class: 'mt-3 block h-72 w-full rounded-md border border-gray-300 bg-white p-2 text-sm shadow-sm focus:border-violet-500 focus:ring-violet-500',
            'data-dual-list-selector-target': 'source'
        }
    }) }}
</div>
