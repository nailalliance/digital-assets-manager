{% form_theme form 'tailwind_form_theme.html.twig' %}
{{ form_start(form) }}
    {{ form_widget(form) }}
    <div class="mt-8 flex justify-end gap-3 border-t border-gray-200 pt-5">
        <a href="{{ path('admin_notifications_index') }}" class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50">
            Back to list
        </a>
        <button class="rounded-md border border-transparent bg-violet-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-violet-700">
            {{ button_label|default('Save') }}
        </button>
    </div>
{{ form_end(form) }}
