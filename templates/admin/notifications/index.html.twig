{% extends 'base.html.twig' %}

{% block title %}Notifications | {{ parent() }}{% endblock %}

{% block body %}
    <div class="mb-6 flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Header Notifications</h1>
            <p class="mt-1 text-sm text-gray-500">Schedule messages in Pacific time and choose how prominently they appear.</p>
        </div>
        <a href="{{ path('admin_notifications_new') }}" class="inline-flex items-center justify-center rounded-md border border-transparent bg-violet-600 px-4 py-2 text-sm font-medium text-white hover:bg-violet-700">
            Create notification
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="mb-4 rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800" role="status">{{ message }}</div>
    {% endfor %}

    <div class="overflow-hidden rounded-lg bg-white shadow-xl">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Notification</th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Level</th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Schedule (Pacific)</th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Status</th>
                    <th class="px-6 py-3"><span class="sr-only">Actions</span></th>
                </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 bg-white">
                {% for notification in notifications %}
                    {% set is_active = notification.isActiveAt(now) %}
                    <tr>
                        <td class="max-w-md px-6 py-4">
                            <div class="font-medium text-gray-900">{{ notification.title }}</div>
                            <div class="mt-1 text-sm text-gray-500">{{ notification.message }}</div>
                        </td>
                        <td class="px-6 py-4">
                            <span class="inline-flex rounded-full px-2 py-1 text-xs font-semibold capitalize
                                {{ notification.level.value == 'info' ? 'bg-blue-100 text-blue-800' : '' }}
                                {{ notification.level.value == 'success' ? 'bg-green-100 text-green-800' : '' }}
                                {{ notification.level.value == 'warning' ? 'bg-amber-100 text-amber-800' : '' }}
                                {{ notification.level.value == 'critical' ? 'bg-red-100 text-red-800' : '' }}">
                                {{ notification.level.value }}
                            </span>
                        </td>
                        <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-600">
                            <div>{{ notification.startsAt|date('M j, Y g:i A T', 'America/Los_Angeles') }}</div>
                            <div class="mt-1">to {{ notification.endsAt|date('M j, Y g:i A T', 'America/Los_Angeles') }}</div>
                        </td>
                        <td class="px-6 py-4 text-sm">
                            {% if not notification.enabled %}
                                <span class="text-gray-500">Disabled</span>
                            {% elseif is_active %}
                                <span class="font-medium text-green-700">Active</span>
                            {% elseif notification.startsAt > now %}
                                <span class="font-medium text-blue-700">Scheduled</span>
                            {% else %}
                                <span class="text-gray-500">Expired</span>
                            {% endif %}
                        </td>
                        <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
                            <a href="{{ path('admin_notifications_edit', {id: notification.id}) }}" class="text-indigo-600 hover:text-indigo-900">Edit</a>
                            <form method="post" action="{{ path('admin_notifications_delete', {id: notification.id}) }}" class="ml-4 inline" onsubmit="return confirm('Delete this notification?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-notification-' ~ notification.id) }}">
                                <button class="text-red-600 hover:text-red-900">Delete</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="px-6 py-8 text-center text-gray-500">No notifications have been created.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
