#!/usr/bin/env bash

set -euo pipefail

# Match the PhpStorm server mapping in .idea/php.xml so file paths resolve.
#export PHP_IDE_CONFIG="${PHP_IDE_CONFIG:-serverName=symfony-local}"

# Ensure the Symfony web server boots PHP with step debugging enabled.
export XDEBUG_MODE="${XDEBUG_MODE:-debug,develop}"
export XDEBUG_CONFIG="${XDEBUG_CONFIG:-client_host=127.0.0.1 client_port=9003 idekey=PHPSTORM}"

exec symfony serve "$@"
